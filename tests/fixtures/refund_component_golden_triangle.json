{
  "meta": {
    "datasetName": "退款构成黄金三角模拟测试数据",
    "dataClassification": "模拟测试数据",
    "warning": "模拟，公式来自外部课程资料，尚待真实样本确认",
    "formulaVersion": "external-course-assumption-v1",
    "currency": "CNY",
    "toleranceCents": 1,
    "rounding": "ROUND_HALF_UP_TO_CENT",
    "formula": {
      "refundRatio": "用户退款金额 ÷ 原订单用户实付金额",
      "expectedPlatformSubsidyClawback": "原订单平台补贴 × 退款比例，按分四舍五入",
      "currentRefundNet": "同子订单、同售后编号的退款资金有符号金额合计",
      "compositionPass": "实际退用户金额与售后金额一致，且实际平台补贴追回与预计追回差额不超过1分"
    },
    "assumptions": [
      "用户退款金额在本测试中指应退还消费者的用户实付部分，不含平台补贴追回。",
      "全额退款时，用户退款金额等于原订单用户实付金额。",
      "只计算平台补贴追回；达人补贴、抖音支付补贴、抖音月付补贴和其他补贴需要单独真实样本和规则。",
      "本数据只用于试运行和自动化测试，不能直接启用为正式抖店规则。"
    ],
    "currentImplementationScope": "refund_reconciliation.py只核对退款资金净额、唯一分组和时间窗口，不核对退用户与退补贴的构成。",
    "sourceFieldMapping": {
      "originalSettlement": ["子订单号", "用户实付", "平台补贴", "达人补贴", "抖音支付补贴", "抖音月付营销补贴"],
      "afterSale": ["售后单号", "商品单号", "售后状态", "退商品金额（元）"],
      "refundSettlement": ["子订单号", "结算单类型", "结算金额"],
      "fund": ["动帐流水号", "子订单号", "售后编号", "动账方向", "动账金额", "动账场景", "订单退款", "实际平台补贴", "实际达人补贴", "实际抖音支付补贴", "实际抖音月付营销补贴"]
    }
  },
